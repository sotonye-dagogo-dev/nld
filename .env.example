# ---------------------------------------------------------------------------
# Next Level Devotional — environment template
# Copy to .env.local (or .env) and fill in real values. NEVER commit real keys.
# Every variable has a documented fallback in src/config unless marked required.
# ---------------------------------------------------------------------------

# Canonical app origin (used for emails and PWA)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (single database + admin auth + storage) ---------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/next_level_devotional
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Paystack ---------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# --- Email Provider Selection -----------------------------------------------
# Set EMAIL_PROVIDER to "resend" or "cloudflare"
EMAIL_PROVIDER=cloudflare

# --- Resend (transactional email) ------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
EMAIL_SERVER_USER=resend
EMAIL_SERVER_PASSWORD=YOUR_API_KEY
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=465
EMAIL_FROM=Next Level Devotional <devotional@your-domain.com>

# --- Cloudflare Workers + MailChannels (free, no domain verification) -------
# See cloudflare-worker/smtp-relay.ts for the worker code
# 1. Deploy the worker to Cloudflare (wrangler deploy)
# 2. Set CLOUDFLARE_EMAIL_WORKER_SECRET in Cloudflare Worker settings
# 3. Use the deployed worker URL here
CLOUDFLARE_EMAIL_WORKER_URL=https://nld-email-relay.your-subdomain.workers.dev
CLOUDFLARE_EMAIL_WORKER_SECRET=your-secure-random-secret

# --- Access password derivation (HMAC key) ----------------------------------
# Keep stable across deploys; rotating invalidates existing access passwords.
ACCESS_PASSWORD_SECRET=change-me-to-a-long-random-string

# --- Bootstrap superadmin (scripts/seed-admin.mjs) --------------------------
# Used ONLY by `npm run db:seed-admin`. Delete the seeded account after the
# real owner takes over (see the script header).
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Dev-only design viewer gate -------------------------------------------
ENABLE_DESIGN_VIEWER=false